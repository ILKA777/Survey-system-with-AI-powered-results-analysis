FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /app

COPY pom.xml .
COPY src ./src
RUN mvn -DskipTests clean package spring-boot:repackage
RUN jar tf target/iipoll-1.0-SNAPSHOT.jar | grep -q "BOOT-INF/lib/"

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

COPY --from=build /app/target/iipoll-1.0-SNAPSHOT.jar app.jar

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
